{
  "name": "chess-prodigy",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run",
    "test:server": "vitest run tests/server",
    "server": "node --import tsx server/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "lint": "eslint src server scripts/test-account-server.ts scripts/calibration deploy/backup.mjs --max-warnings=0",
    "format:check": "prettier --check src tests/engine tests/coach tests/game tests/storage tests/worker tests/ui vite.config.ts tsconfig.json server tests/server tests/account scripts/test-account-server.ts deploy/backup.mjs tsconfig.server.json scripts/calibration tests/calibration",
    "format": "prettier --write src tests/engine tests/coach tests/game tests/storage tests/worker tests/ui vite.config.ts tsconfig.json server tests/server tests/account scripts/test-account-server.ts deploy/backup.mjs tsconfig.server.json scripts/calibration tests/calibration",
    "preview": "vite preview --host 127.0.0.1",
    "test:accessibility": "node scripts/check-accessibility.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
