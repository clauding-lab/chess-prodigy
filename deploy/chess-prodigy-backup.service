[Unit]
Description=Back up Chess Prodigy private database
After=chess-prodigy.service

[Service]
Type=oneshot
User=chess-prodigy
Group=chess-prodigy
WorkingDirectory=/opt/chess-prodigy/current
EnvironmentFile=/etc/chess-prodigy.env
ExecStart=/usr/bin/node deploy/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chess-prodigy
