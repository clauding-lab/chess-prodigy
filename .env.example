# Local only. Generate AUTH_SECRET with: openssl rand -hex 48
NODE_ENV=development
BASE_URL=http://127.0.0.1:4317
PORT=4317
DATABASE_PATH=./data/chess.sqlite
AUTH_SECRET=

# Optional delivery. Keep real credentials only on the server.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Chess Prodigy
# Generate privately with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
